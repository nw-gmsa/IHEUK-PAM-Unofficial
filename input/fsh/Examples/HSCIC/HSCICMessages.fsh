Instance:    hscic-a22-advanced
InstanceOf:  PAMBundleMessage
Title:       "HSCIC ADT^A22^ADT_A21 - ReturnFromLeaveOfAbsence ADT-A22"
Description: "FHIR Message equivalent of the HSCIC ITK example ADT^A22^ADT_A21 (converted to HL7 v2.5.1). Mrs Editestpatient returned to York Hospital for another visit to the clinical oncology department to see Dr Darwin. As part of a series of visits, Mrs Editestpatient was allowed to take a leave of absence to return home to Malton following treatment until her next appointment. Mrs Cortana the receptionist, greeted Mrs Editestpatient as she arrived and marked her in the PAS system as returned from leave of absence, triggering an A22 HL7 message."
Usage:       #example
* identifier.value = "1340389132045390"
* type = #message
* timestamp = "2010-02-26T10:34:00+00:00"
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/MessageHeader/hscic-a22-advanced-header", hscic-a22-advanced-header)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Provenance/hscic-a22-advanced-event", hscic-a22-advanced-event)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Patient/Patient-EDITESTPATIENT-TEN-9999999557", Patient-EDITESTPATIENT-TEN-9999999557)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Encounter/hscic-a22-advanced-encounter", hscic-a22-advanced-encounter)
