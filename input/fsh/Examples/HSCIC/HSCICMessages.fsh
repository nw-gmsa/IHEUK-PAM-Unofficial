Instance:    hscic-a27-pending
InstanceOf:  PAMBundleMessage
Title:       "HSCIC ADT^A27^ADT_A21 - CancelPendingAdmit ADT-A27"
Description: "FHIR Message equivalent of the HSCIC ITK example ADT^A27^ADT_A21 (converted to HL7 v2.5.1). Mrs Editestpatient following her outpatient appointment was told she should be admitted for further tests. In advance of admitting Mrs Editestpatient, a pending admission was set up in the PAS by Miss Cortana the receptionist, to inform the ward of her arrival so a bed could be prepared. However shortly after this, Mrs Editestpatient decided not want to stay in the hospital further and since Dr Darwin had declared Mrs Editestpatient was medically fit, she did not have to be admitted. Miss Cortana cancelled her previous pending admission triggering a A27 HL7 message."
Usage:       #example
* identifier.value = "1340389132045399"
* type = #message
* timestamp = "2010-01-23T14:00:00+00:00"
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/MessageHeader/hscic-a27-pending-header", hscic-a27-pending-header)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Provenance/hscic-a27-pending-event", hscic-a27-pending-event)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Patient/Patient-EDITESTPATIENT-TEN-9999999557", Patient-EDITESTPATIENT-TEN-9999999557)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Encounter/hscic-a27-pending-encounter", hscic-a27-pending-encounter)

