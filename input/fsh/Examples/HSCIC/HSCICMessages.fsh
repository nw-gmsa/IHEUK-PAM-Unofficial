* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/RelatedPerson/RelatedPerson-EDITESTPATIENT-ALBERT", RelatedPerson-EDITESTPATIENT-ALBERT)
* insert Entry("https://fhir.ihe-uk.org/ITI/PAM/Condition/hscic-a08-encounter-condition-1", hscic-a08-encounter-condition-1)

